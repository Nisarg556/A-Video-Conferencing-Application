# Copy to server/.env and adjust. Never commit the real .env.

NODE_ENV=development
PORT=4000

# Local Docker Mongo (npm run db:up) or a MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/confer

# Frontend origin: used for the CORS allowlist and for building invite links
CLIENT_URL=http://localhost:5173

# Signs participant tokens. At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-string-of-at-least-32-chars

# ---------- WebRTC / NAT traversal ----------
# STUN lets browsers discover their public address. Comma-separated.
# Leave unset for Google's public STUN servers; set to empty to disable.
# STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# TURN relays media when peers can't connect directly (symmetric NAT, corporate
# firewalls, some mobile networks). Without it ~10-20% of real calls never connect.
# Include a TCP/TLS URL for networks that block UDP. Comma-separated.
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp

# Option A (preferred, self-hosted coturn with use-auth-secret): the server mints
# short-lived per-participant credentials from this shared secret.
# TURN_SECRET=

# Option B (managed TURN such as Metered/Twilio free tiers): static credentials.
# TURN_USERNAME=
# TURN_CREDENTIAL=

# "all" (default) or "relay" to force every call through TURN (to test TURN works).
# ICE_TRANSPORT_POLICY=all

# ---------- Logging ----------
# JSON logs in production, pretty-printed in development. Default: info (silent in tests).
# LOG_LEVEL=info
