# Copy to client/.env.local if you need to override defaults.
# Only variables prefixed with VITE_ are exposed to browser code — never put secrets here.

# Base URL of the API. Leave empty in development: Vite proxies /api to the server.
# In production, set it to the deployed backend, e.g. https://confer-api.onrender.com
VITE_API_URL=

# Where the dev proxy forwards /api (only used by `npm run dev`)
API_PROXY_TARGET=http://localhost:4000
